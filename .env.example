# API / mock catalog
PORT=3000
MOCK_API_KEY=easy-poc-belladati
ENFORCE_MOCK_API_KEY=true

# ElevenLabs - NEVER expose these in Vite/public env variables
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_ENVIRONMENT=production

# Optional: when Cencosud gives the real API, the adapter can point here
CENCOSUD_SEARCH_BASE_URL=
CENCOSUD_SEARCH_API_KEY=
USE_REAL_CENCOSUD_API=false

# Frontend dev server proxy target
VITE_API_BASE_URL=
